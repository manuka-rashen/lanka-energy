{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "appName": {"type":"string","defaultValue":"[concat('lanka-energy-', uniqueString(resourceGroup().id))]","minLength":2,"maxLength":60},
    "location": {"type":"string","defaultValue":"[resourceGroup().location]"},
    "repositoryUrl": {"type":"string","defaultValue":"https://github.com/manuka-rashen/lanka-energy"},
    "branch": {"type":"string","defaultValue":"main"}
  },
  "variables": {"planName":"[concat(parameters('appName'), '-free-plan')]"},
  "resources": [
    {"type":"Microsoft.Web/serverfarms","apiVersion":"2023-12-01","name":"[variables('planName')]","location":"[parameters('location')]","kind":"linux","sku":{"name":"F1","tier":"Free","capacity":1},"properties":{"reserved":true}},
    {"type":"Microsoft.Web/sites","apiVersion":"2023-12-01","name":"[parameters('appName')]","location":"[parameters('location')]","kind":"app,linux","dependsOn":["[resourceId('Microsoft.Web/serverfarms', variables('planName'))]"],"properties":{"serverFarmId":"[resourceId('Microsoft.Web/serverfarms', variables('planName'))]","httpsOnly":true,"siteConfig":{"linuxFxVersion":"PYTHON|3.12","appCommandLine":"sh startup.sh","alwaysOn":false,"ftpsState":"Disabled","minTlsVersion":"1.2","appSettings":[{"name":"SCM_DO_BUILD_DURING_DEPLOYMENT","value":"true"},{"name":"WEBSITE_HTTPLOGGING_RETENTION_DAYS","value":"3"}]}}},
    {"type":"Microsoft.Web/sites/sourcecontrols","apiVersion":"2023-12-01","name":"[concat(parameters('appName'), '/web')]","dependsOn":["[resourceId('Microsoft.Web/sites', parameters('appName'))]"],"properties":{"repoUrl":"[parameters('repositoryUrl')]","branch":"[parameters('branch')]","isManualIntegration":true}}
  ],
  "outputs":{"appUrl":{"type":"string","value":"[concat('https://', reference(resourceId('Microsoft.Web/sites', parameters('appName')), '2023-12-01').defaultHostName)]"},"plan":{"type":"string","value":"F1 Free; shared resources and daily CPU quota; no automatic upgrade."}}
}
